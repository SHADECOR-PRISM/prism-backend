  "components": {
    "schemas": {
      "AdminUserItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "default": ""
          },
          "role": {
            "type": "string",
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "role"
        ],
        "title": "AdminUserItem"
      },
      "AnalyticsSummaryResponse": {
        "properties": {
          "status_counts": {
            "$ref": "#/components/schemas/StatusCounts"
          },
          "expenses": {
            "$ref": "#/components/schemas/ExpenseBreakdown"
          }
        },
        "type": "object",
        "required": [
          "status_counts",
          "expenses"
        ],
        "title": "AnalyticsSummaryResponse"
      },
      "ApplicationApprovalRequest": {
        "properties": {
          "container_id": {
            "type": "string",
            "format": "uuid",
            "title": "Container Id"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/CardStatusUpdateItem"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "container_id",
          "version",
          "details"
        ],
        "title": "ApplicationApprovalRequest"
      },
      "ApplicationCreateRequest": {
        "properties": {
          "header": {
            "$ref": "#/components/schemas/ApplicationHeaderCreate"
          },
          "transport_details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/TransportDetailCreate"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transport Details"
          },
          "expense_details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ExpenseDetailCreate"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expense Details"
          }
        },
        "type": "object",
        "required": [
          "header"
        ],
        "title": "ApplicationCreateRequest"
      },
      "ApplicationCreateResponse": {
        "properties": {
          "header_id": {
            "type": "string",
            "format": "uuid",
            "title": "Header Id"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "total_amount": {
            "type": "integer",
            "title": "Total Amount"
          }
        },
        "type": "object",
        "required": [
          "header_id",
          "message",
          "total_amount"
        ],
        "title": "ApplicationCreateResponse"
      },
      "ApplicationHeaderCreate": {
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid",
            "title": "Project Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "expense",
              "income"
            ],
            "title": "Type",
            "default": "expense"
          },
          "category": {
            "type": "string",
            "maxLength": 100,
            "title": "Category"
          }
        },
        "type": "object",
        "required": [
          "project_id",
          "category"
        ],
        "title": "ApplicationHeaderCreate"
      },
      "ApplicationUpdateRequest": {
        "properties": {
          "container_id": {
            "type": "string",
            "format": "uuid",
            "title": "Container Id"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "updated_details": {
            "items": {
              "$ref": "#/components/schemas/UpdateDetailItem"
            },
            "type": "array",
            "title": "Updated Details",
            "default": []
          },
          "deleted_detail_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Deleted Detail Ids",
            "default": []
          },
          "is_all_deleted": {
            "type": "boolean",
            "title": "Is All Deleted",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "container_id",
          "version"
        ],
        "title": "ApplicationUpdateRequest"
      },
      "ApplicationUpdateResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "title": "ApplicationUpdateResponse"
      },
      "BulkContainerDetailsRequest": {
        "properties": {
          "container_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Container Ids"
          }
        },
        "type": "object",
        "required": [
          "container_ids"
        ],
        "title": "BulkContainerDetailsRequest"
      },
      "CardStatusUpdateItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "title": "CardStatusUpdateItem"
      },
      "Container": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "project_name": {
            "type": "string",
            "title": "Project Name"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "applied_at": {
            "type": "string",
            "title": "Applied At"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ],
            "title": "Status"
          },
          "total_amount": {
            "type": "integer",
            "title": "Total Amount"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "project_name",
          "category",
          "applied_at",
          "status",
          "total_amount",
          "version"
        ],
